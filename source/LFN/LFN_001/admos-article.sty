}

\renewcommand\subsection{
	\@startsection{subsection}{2}{0pt}
	{1.15em plus .2em minus .1em}
	{0.4em}
	{\color{AdMOSNavy}\bfseries\fontsize{11.6}{14}\selectfont}
}

\makeatother

% ---------- Figure and table captions ----------
\captionsetup{
	font={small,it},
	labelfont={bf,it,color=AdMOSGold},
	textfont={it,color=AdMOSGold},
	labelsep=colon,
	justification=raggedright,
	singlelinecheck=false,
	skip=5pt
}

% ---------- Reusable figure placeholder ----------
\newcommand{\FigurePlaceholder}[2][52mm]{%
	\begin{figure}[htbp]
		
		\centering
		
		\fbox{%
			\begin{minipage}[c][#1][c]{0.72\linewidth}
				\centering
				\color{gray}
				\bfseries
				Insert figure here
			\end{minipage}%
		}
		
		\caption{#2}
		
	\end{figure}
}

