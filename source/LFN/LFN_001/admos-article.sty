% ---------- Full-page header and footer ----------
\newcommand{\AdMOSPageFurniture}{%
	\begin{tikzpicture}[remember picture,overlay]
		
		% Header image, full bleed across page width
		\node[anchor=north west,inner sep=0pt] at (current page.north west) {%
			\includegraphics[width=\paperwidth]{admos-letterhead.png}%
		};
		
		% Header label on top of the navy banner
		\node[
		anchor=west,
		text=white,
		font=\bfseries\fontsize{10.5}{11.5}\selectfont
		]
		at ([xshift=19mm,yshift=-10.3mm]current page.north west)
		{\ArticleType};
		
		% Footer navy bar
		\fill[AdMOSNavy]
		(current page.south west)
		rectangle
		([yshift=7.2mm]current page.south east);
		
		% Footer text
		\node[
		anchor=west,
		text=white,
		font=\bfseries\fontsize{8.2}{9}\selectfont
		]
		at ([xshift=4.5mm,yshift=3.6mm]current page.south west)
		{\ContactEmail};
		
		\node[
		anchor=center,
		text=white,
		font=\bfseries\fontsize{8.2}{9}\selectfont
		]
		at ([yshift=3.6mm]current page.south)
		{\textcopyright\ \CompanyName};
		
		\node[
		anchor=east,
		text=white,
		font=\bfseries\fontsize{8.2}{9}\selectfont
		]
		at ([xshift=-4.5mm,yshift=3.6mm]current page.south east)
		{\thepage\ / \pageref*{LastPage}};
		
	\end{tikzpicture}%
}

\AddToShipoutPictureFG{\AdMOSPageFurniture}

% ---------- Metadata line used on page 1 ----------
\newcommand{\ArticleMetadata}{%
	
	% Top orange line
	\noindent
	{\color{AdMOSGold}\rule{\textwidth}{1.5pt}}
	
	\vspace{-2mm}
	
	% Metadata row
	\noindent
	\begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} l l r @{}}
		
		\textcolor{AdMOSGold}{%
			\textbf{Series:} \ArticleSeries
		}
		&
		\textcolor{AdMOSGold}{%
			\textbf{Article ID:} \ArticleID
		}
		&
		\textcolor{AdMOSGold}{%
			\ArticleDate
		}
		
	\end{tabular*}
	
	\vspace{-4mm}
	
	% Bottom orange line
	\noindent
	{\color{AdMOSGold}\rule{\textwidth}{1.5pt}}
	\par
	
	\vspace{4.5mm}
}

% ---------- Title block ----------
\newcommand{\ArticleTitleBlock}{%
	{\color{AdMOSNavy}
		\bfseries
		\fontsize{28}{23}\selectfont
		\raggedright
		\hyphenpenalty=10000
		\exhyphenpenalty=10000
		\ArticleTitle
		\par}
	
	\vspace{1.05em}
	
	{\color{AdMOSNavy}
		\bfseries
		\fontsize{16}{17}\selectfont
		\raggedright
		\hyphenpenalty=10000
		\exhyphenpenalty=10000
		\ArticleSubtitle
		\par}
	
	\vspace{0.65em}
}

% ---------- Section formatting ----------
\makeatletter

